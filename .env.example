# Not used by V1 — the live-price layer and simulated buy feed need no
# credentials. These are Phase 2 requirements (real on-chain buy feed);
# see INVENTORY.md for the phasing and why onLogs was swapped for polling.

# Solana RPC endpoint with archival/getParsedTransaction support.
# Helius (recommended, free tier works) or QuickNode both fit.
SOLANA_RPC_URL=

# Minimum USD notional for a buy to appear in the feed (wash-trade filter).
MIN_BUY_USD=25

# How long, in seconds, a wallet is suppressed from reappearing in the feed
# after a qualifying buy (second wash-trade filter).
WALLET_DEDUPE_SECONDS=300

# Upstash Redis — shared cache for price snapshot, buy ring buffer, and
# wallet-dedupe state (see INVENTORY.md "Data layer").
KV_REST_API_URL=
KV_REST_API_TOKEN=
